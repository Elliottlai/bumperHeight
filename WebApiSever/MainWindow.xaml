<Window x:Class="WebApiSever.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CIM Web API Server" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Ellipse x:Name="StatusLight" Width="16" Height="16"
                     Fill="LimeGreen" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtStatus" Text="Server Running: http://0.0.0.0:8069"
                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#1E1E1E"
                     Foreground="LightGreen"
                     TextWrapping="Wrap"
                     VerticalAlignment="Stretch"/>
        </ScrollViewer>

        <Button Grid.Row="2" Content="清除 Log" Width="100"
                HorizontalAlignment="Right" Margin="0,8,0,0"
                Click="BtnClear_Click"/>
    </Grid>
</Window>