<Window x:Class="DeltaAxis_RS485.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeltaAxis_RS485.ViewModels"
        xmlns:v="clr-namespace:DeltaAxis_RS485.Views"
        Title="Delta ASDA-B3 多軸控制" Height="800" Width="1200">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <DockPanel>
        <!-- 頂部工具列 -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="全部連線" Command="{Binding ConnectAllCommand}" />
            <Button Content="全部斷線" Command="{Binding DisconnectAllCommand}" />
            <Separator />
            <TextBlock Text="Slot_Inspection Config路徑：" VerticalAlignment="Center" Margin="8,0,4,0" />
            <TextBox Text="{Binding SlotInspectionConfigPath, UpdateSourceTrigger=PropertyChanged}" Width="320"
                     VerticalAlignment="Center"
                     ToolTip="留白則自動尋找（環境變數 SLOT_INSPECTION_CONFIG → 上次成功路徑 → exe 旁 → 開發機相對路徑 → 機台網路路徑）。讀取成功後會自動填成實際採用的絕對路徑。" />
            <Button Content="讀取安全設定" Command="{Binding LoadSafetyConfigCommand}" Margin="4,0,0,0" />
            <CheckBox Content="自動跟隨主程式變更" IsChecked="{Binding AutoFollowSlotInspectionConfig}"
                      VerticalAlignment="Center" Margin="8,0,0,0"
                      ToolTip="勾選後，主程式存檔修改 InspectionConfig.json / SlotPositions.json 時，本工具會自動重新載入安全設定（約 1 秒延遲）。" />
        </ToolBar>

        <!-- 底部狀態列 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SafetyConfigStatusMessage}" Margin="0,0,16,0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedAxis.StatusMessage, FallbackValue='就緒'}" />
            </StatusBarItem>
        </StatusBar>

        <!-- 每軸一個 Tab -->
        <TabControl ItemsSource="{Binding Axes}"
                    SelectedItem="{Binding SelectedAxis}" SelectionChanged="TabControl_SelectionChanged">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,4,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Gray" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="LimeGreen" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                            <Setter Property="Fill" Value="Red" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Config.Name}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <v:AxisControlView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
