<Window x:Class="Slot_Inspection.Views.PositionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helper="clr-namespace:Slot_Inspection.Helper"
        Title="Recipe 切換"
        Width="680"
        Height="610"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <helper:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <!-- 每列高度統一 32 -->
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="IndexText" TargetType="TextBlock">
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#AAA"/>
            <!-- 只有 Permission.PositionSettings（不只 RecipeSwitch）才能編輯座標本身；
                 DataTemplate 內的 DataContext 是各筆 AxisPositionEntry，要往上找到 Window 的
                 DataContext（PositionSettingsViewModel）才能讀到 CannotEditCoordinates。 -->
            <Setter Property="IsReadOnly" Value="{Binding DataContext.CannotEditCoordinates, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#EEEEEE"/>
                    <Setter Property="Foreground" Value="#777"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 奇偶行底色 DataTemplate 在 ItemsControl 中套用 -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Recipe（Y/ZL/ZR 參數組合）管理列 ═══ -->
        <Border Grid.Row="0" Margin="10,10,10,0" Padding="8,6" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="參數組合 (Recipe)：" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Padding="0,0,6,0"/>
                    <ComboBox x:Name="CmbRecipe" Width="200" IsEditable="True" FontSize="13"
                              ItemsSource="{Binding RecipeNames}" Text="{Binding SelectedRecipeName, Mode=TwoWay}"
                              ToolTip="輸入新名稱可建立新Recipe；選擇既有名稱可讀取或覆蓋備份。"/>
                    <Button Content="讀取套用" Width="76" Margin="8,0,0,0" Background="#2E86C1" Foreground="White"
                            Click="BtnLoadRecipe_Click"
                            ToolTip="把所選Recipe的座標與演算法參數套用到目前生效中的設定（會覆蓋目前設定）。"/>
                    <Button Content="備份／建立" Width="84" Margin="6,0,0,0" Background="#1E8449" Foreground="White"
                            Click="BtnNewRecipe_Click" IsEnabled="{Binding CanEditCoordinates}"
                            ToolTip="立即把『目前生效中』的座標與全部演算法參數JSON，存成一份新的Recipe備份（同名會覆蓋）。"/>
                    <Button Content="刪除" Width="64" Margin="6,0,0,0" Background="#C0392B" Foreground="White"
                            Click="BtnDeleteRecipe_Click" IsEnabled="{Binding CanEditCoordinates}"
                            ToolTip="刪除所選的Recipe備份（不影響目前生效中的設定）。"/>
                    <TextBlock Margin="12,4,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#555"
                               Text="{Binding CurrentRecipeName, StringFormat='目前生效中：{0}'}"/>
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#777" TextWrapping="Wrap"
                           Text="備份／建立：立即把「目前生效中」的座標設定＋全部演算法參數JSON一起存成一份Recipe（按下去的瞬間就會備份，不是之後才備份）。讀取套用：把所選Recipe的內容覆蓋回目前生效中的設定。若修改座標後忘記備份，按「確認套用」離開時會自動提醒。（QC 基準與比對已移到主畫面的「🔍 QC 比對」獨立視窗。）"/>
            </StackPanel>
        </Border>

        <!-- ═══ TabControl ═══ -->
        <TabControl Grid.Row="1" Margin="10,10,10,0" FontSize="13">

            <!-- ══ Y 軸分頁：R組/L組 各 25 點 ══ -->
            <TabItem Header="Y 軸（25 點）">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- R 組 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="#1E7E5E">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="R 組 (X12)" Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Padding="6,0" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Y 座標 (mm)" Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Padding="4,0" FontSize="12"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding YPositions_R}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Style="{StaticResource IndexText}" FontSize="12"/>
                                                <TextBox Grid.Column="1" Margin="4,3"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                                                         Style="{StaticResource ValueBox}" FontSize="12"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 分隔線 -->
                    <Rectangle Grid.Column="1" Fill="#DDD"/>

                    <!-- L 組 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="#2E5E7E">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="L 組 (X13)" Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Padding="6,0" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Y 座標 (mm)" Foreground="White" FontWeight="Bold"
                                       VerticalAlignment="Center" Padding="4,0" FontSize="12"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding YPositions_L}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Style="{StaticResource IndexText}" FontSize="12"/>
                                                <TextBox Grid.Column="1" Margin="4,3"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                                                         Style="{StaticResource ValueBox}" FontSize="12"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══ ZL 軸分頁（R組 X12 / L組 X13）══ -->
            <TabItem Header="ZL 軸">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- R組 標題 -->
                    <Grid Grid.Row="0" Background="#1E7E5E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R組" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Column="1" Text="座標 (mm)" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="4,0"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ZLPositions_R}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource IndexText}"/>
                                        <TextBox Grid.Column="1" Margin="4,3"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                                                 Style="{StaticResource ValueBox}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- L組 標題 -->
                    <Grid Grid.Row="2" Background="#2E5E7E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="L組" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Column="1" Text="座標 (mm)" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="4,0"/>
                    </Grid>
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding ZLPositions_L}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource IndexText}"/>
                                        <TextBox Grid.Column="1" Margin="4,3"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                                                 Style="{StaticResource ValueBox}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- ══ ZR 軸分頁（R組 X12 / L組 X13）══ -->
            <TabItem Header="ZR 軸">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- R組 標題 -->
                    <Grid Grid.Row="0" Background="#7B3FA0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R組" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Column="1" Text="座標 (mm)" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="4,0"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ZRPositions_R}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource IndexText}"/>
                                        <TextBox Grid.Column="1" Margin="4,3"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                                                 Style="{StaticResource ValueBox}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- L組 標題 -->
                    <Grid Grid.Row="2" Background="#3F5FA0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="L組" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Column="1" Text="座標 (mm)" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="4,0"/>
                    </Grid>
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding ZRPositions_L}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource IndexText}"/>
                                        <TextBox Grid.Column="1" Margin="4,3"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                                                 Style="{StaticResource ValueBox}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- ══ 取料位座標分頁 ══ -->
            <TabItem Header="取料位座標">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#2E6BA1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="項目" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Column="1" Text="座標 (mm)" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="4,0"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PickPositions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource IndexText}"/>
                                        <TextBox Grid.Column="1" Margin="4,3"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                                                 Style="{StaticResource ValueBox}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- ══ X 軸分頁 ══ -->
            <TabItem Header="X 軸">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#C0660A">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="項目" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="6,0"/>
                        <TextBlock Grid.Column="1" Text="座標 (mm)" Foreground="White" FontWeight="Bold"
                                   VerticalAlignment="Center" Padding="4,0"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding XPositions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Style="{StaticResource IndexText}"/>
                                        <TextBox Grid.Column="1" Margin="4,3"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"
                                                 Style="{StaticResource ValueBox}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══ 底部按鈕 ══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="10,8,10,10">
            <Button Content="取消" Width="88" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="確認套用" Width="100" Height="32" IsDefault="True"
                    Click="BtnOk_Click"
                    Background="#2E86C1" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
