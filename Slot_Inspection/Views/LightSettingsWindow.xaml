<Window x:Class="Slot_Inspection.Views.LightSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helper="clr-namespace:Slot_Inspection.Helper"
        Title="設定" Height="290" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <helper:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="140"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="8,8,8,4">

            <!-- Tab 1: brightness -->
            <TabItem Header="💡 亮度設定">
                <StackPanel Margin="16,16,16,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="左相機 亮度 (CH1)" Style="{StaticResource RowLabel}"/>
                        <Slider Width="200" Minimum="0" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,10,0"
                                Value="{Binding LightIntensityLeft, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Style="{StaticResource NumBox}"
                                 Text="{Binding LightIntensityLeft, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="右相機 亮度 (CH2)" Style="{StaticResource RowLabel}"/>
                        <Slider Width="200" Minimum="0" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="0,0,10,0"
                                Value="{Binding LightIntensityRight, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Style="{StaticResource NumBox}"
                                 Text="{Binding LightIntensityRight, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"/>
                    </StackPanel>

                    <!-- 測試按鈕：直接把目前滑桿上的百分比送到硬體，不用按 OK、也不用跑 RUN/DryRun -->
                    <StackPanel Orientation="Horizontal" Margin="140,4,0,0">
                        <Button Content="測試開燈" Width="90" Height="28" Margin="0,0,8,0"
                                Command="{Binding TestLightOnCommand}"
                                Background="#C6EFCE" FontWeight="Bold"
                                ToolTip="用目前滑桿上的百分比立即開燈，不用按 OK 存檔"/>
                        <Button Content="測試關燈" Width="90" Height="28"
                                Command="{Binding TestLightOffCommand}"
                                Background="#F8CECC" FontWeight="Bold"
                                ToolTip="兩通道都設為 0%，確認燈真的有被控制"/>
                    </StackPanel>
                    <TextBlock Margin="140,6,0,0" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding TestResultMessage}"/>
                </StackPanel>
            </TabItem>

            <!-- Tab 2: value limits -->
            <TabItem Header="📊 Value 極限">
                <Grid Margin="16,16,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Value 下限 (mm²)" Style="{StaticResource RowLabel}"/>
                        <TextBox Style="{StaticResource NumBox}"
                                 Text="{Binding ValueLimitLow, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="低於此值視為異常" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="#555" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="Value 上限 (mm²)" Style="{StaticResource RowLabel}"/>
                        <TextBox Style="{StaticResource NumBox}"
                                 Text="{Binding ValueLimitHigh, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="高於此值視為異常" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="#555" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" FontSize="11" Foreground="#999"
                               Text="按 OK 儲存至 config.json，下次啟動自動載入。"/>
                </Grid>
            </TabItem>

            <!-- Tab 3: exposure time (Admin only) -->
            <TabItem Header="📷 曝光時間" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="16,16,16,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="左相機 曝光 (µs)" Style="{StaticResource RowLabel}"/>
                        <TextBox Style="{StaticResource NumBox}"
                                 Text="{Binding ExposureTimeLeft, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="右相機 曝光 (µs)" Style="{StaticResource RowLabel}"/>
                        <TextBox Style="{StaticResource NumBox}"
                                 Text="{Binding ExposureTimeRight, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" FontSize="11" Foreground="#999"
                               Text="按 OK 儲存至 config.json，下次 DryRun 立即套用。"/>
                </StackPanel>
            </TabItem>

            <!-- Tab 4: board sensor pause (Admin only) -->
            <TabItem Header="🛑 板子感測" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="16,16,16,8" VerticalAlignment="Center">
                    <CheckBox Content="停用 X3 板子感測" FontWeight="Bold" Margin="0,0,0,12"
                              IsChecked="{Binding PauseX3BoardSensor}"/>
                    <CheckBox Content="停用 X11 板子感測" FontWeight="Bold" Margin="0,0,0,12"
                              IsChecked="{Binding PauseX11BoardSensor}"/>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#999" TextWrapping="Wrap"
                               Text="停用後，即使該感測器偵測到板子未放妥，也不會擋下 RUN，僅供排除感測器異常時應急使用。按 OK 儲存至 config.json 後立即生效。"/>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- footer buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="8,0,8,10">
            <Button Content="OK" Width="80" Height="30" Margin="0,0,8,0"
                    IsDefault="True" Click="BtnOk_Click"
                    Background="#C6EFCE" FontWeight="Bold"/>
            <Button Content="取消" Width="80" Height="30"
                    IsCancel="True" Click="BtnCancel_Click"
                    Background="#FFCCCC"/>
        </StackPanel>
    </Grid>
</Window>