<Window x:Class="Slot_Inspection.Views.QcComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QC 基準比對" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding RecipeName, StringFormat=Recipe：{0}}" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BaselineSavedAt, StringFormat=基準時間：{0:yyyy-MM-dd HH:mm}}" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BaselineSavedBy, StringFormat=建立者：{0}}" Margin="0,0,20,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ExceedCount, StringFormat=超出容差：{0} 個 Slot}" FontWeight="Bold" Foreground="#C00000" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F5F5F5">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ExceedsTolerance}" Value="True">
                            <Setter Property="Background" Value="#E60000"/>
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="區域" Binding="{Binding Area}" Width="50"/>
                <DataGridTextColumn Header="Slot" Binding="{Binding Name}" Width="90"/>
                <DataGridTextColumn Header="Value 基準" Binding="{Binding BaselineValue, StringFormat=F3}" Width="80"/>
                <DataGridTextColumn Header="Value 目前" Binding="{Binding CurrentValue, StringFormat=F3}" Width="80"/>
                <DataGridTextColumn Header="Value Δ" Binding="{Binding DeltaValue, StringFormat=F3}" Width="80"/>
                <DataGridTextColumn Header="亮度 基準" Binding="{Binding BaselineMeanIntensity, StringFormat=F1}" Width="80"/>
                <DataGridTextColumn Header="亮度 目前" Binding="{Binding CurrentMeanIntensity, StringFormat=F1}" Width="80"/>
                <DataGridTextColumn Header="亮度 Δ" Binding="{Binding DeltaMeanIntensity, StringFormat=F1}" Width="80"/>
                <DataGridTextColumn Header="位置 基準" Binding="{Binding BaselineDistanceToRoiCenter, StringFormat=F3}" Width="80"/>
                <DataGridTextColumn Header="位置 目前" Binding="{Binding CurrentDistanceToRoiCenter, StringFormat=F3}" Width="80"/>
                <DataGridTextColumn Header="位置 Δ" Binding="{Binding DeltaDistanceToRoiCenter, StringFormat=F3}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
