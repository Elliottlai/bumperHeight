<Window x:Class="Slot_Inspection.Views.RolePermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色權限設定"
        Width="600" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" FontSize="12" Foreground="#555" TextWrapping="Wrap"
                   Text="勾選代表該角色可以使用這項功能。Admin永遠擁有全部權限，不受這張表影響，所以不列在下面。"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Operator" FontWeight="Bold" HorizontalAlignment="Center" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="Engineer" FontWeight="Bold" HorizontalAlignment="Center" FontSize="13"/>
                </Grid>

                <TextBlock Text="基本機台操作" FontWeight="Bold" Background="#2E6BA1" Foreground="White"
                           Padding="6,4" Margin="0,4,0,0"/>
                <ItemsControl ItemsSource="{Binding BasicRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="13"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding OperatorAllowed}" HorizontalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding EngineerAllowed}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="進階設定" FontWeight="Bold" Background="#7B3FA0" Foreground="White"
                           Padding="6,4" Margin="0,16,0,0"/>
                <ItemsControl ItemsSource="{Binding AdvancedRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="13"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding OperatorAllowed}" HorizontalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding EngineerAllowed}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="88" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="儲存" Width="100" Height="32" IsDefault="True"
                    Background="#2E86C1" Foreground="White" FontWeight="Bold"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
