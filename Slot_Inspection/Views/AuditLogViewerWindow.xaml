<Window x:Class="Slot_Inspection.Views.AuditLogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作紀錄 (Audit Log)"
        Width="780" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 篩選列 -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <WrapPanel>
                <TextBlock Text="日期：" VerticalAlignment="Center" FontSize="13"/>
                <ComboBox x:Name="CmbDate" Width="120" Margin="6,0,16,0"
                          SelectionChanged="CmbDate_SelectionChanged"/>
                <TextBlock Text="帳號篩選：" VerticalAlignment="Center" FontSize="13"/>
                <TextBox x:Name="TxtUsernameFilter" Width="110" Margin="6,0,16,0" TextChanged="Filter_Changed"/>
                <TextBlock Text="關鍵字：" VerticalAlignment="Center" FontSize="13"/>
                <TextBox x:Name="TxtKeywordFilter" Width="160" Margin="6,0,16,0" TextChanged="Filter_Changed"/>
                <Button Content="重新整理" Padding="10,4" Click="BtnRefresh_Click"/>
                <Button Content="開啟所在資料夾" Padding="10,4" Margin="8,0,0,0" Click="BtnOpenFolder_Click"/>
            </WrapPanel>
        </Border>

        <!-- 清單 -->
        <ListView x:Name="LstEntries" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="時間" Width="150"
                                    DisplayMemberBinding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                    <GridViewColumn Header="帳號" Width="120" DisplayMemberBinding="{Binding Username}"/>
                    <GridViewColumn Header="角色" Width="90" DisplayMemberBinding="{Binding Role}"/>
                    <GridViewColumn Header="動作" Width="360" DisplayMemberBinding="{Binding Action}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="TxtCount" Grid.Row="2" Margin="0,10,0,0" FontSize="12" Foreground="#777"/>
    </Grid>
</Window>
