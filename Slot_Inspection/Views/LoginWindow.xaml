<Window x:Class="Slot_Inspection.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登入"
        Width="360" Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#EFEFEF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="聯策科技 Slot Inspection" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="帳號" FontSize="13" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtUsername" Grid.Row="2" FontSize="14" Padding="6,4" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Text="密碼" FontSize="13" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PwdPassword" Grid.Row="4" FontSize="14" Padding="6,4" Margin="0,0,0,4"
                     KeyDown="PwdPassword_KeyDown"/>

        <TextBlock x:Name="TxtError" Grid.Row="5" Foreground="#C0392B" FontSize="12"
                   TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,4,0,0"/>

        <Button Grid.Row="6" Content="登入" Width="100" Height="32" HorizontalAlignment="Right"
                Background="#2E86C1" Foreground="White" FontWeight="Bold"
                Click="BtnLogin_Click"/>
    </Grid>
</Window>
