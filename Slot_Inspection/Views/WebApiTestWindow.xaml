<Window x:Class="Slot_Inspection.Views.WebApiTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌐 WebAPI 設定" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- URL + EquipmentId + 開關 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="WebAPI 啟用：" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkEnabled" Grid.Column="1"
                      Margin="0,4,0,4" VerticalAlignment="Center"
                      Content="啟用 MES WebAPI 功能"/>

            <Label Grid.Row="1" Content="BaseUrl：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtBaseUrl" Grid.Row="1" Grid.Column="1"
                     Margin="0,4,0,4" Padding="4,3" VerticalAlignment="Center"
                     FontFamily="Consolas" FontSize="12"/>

            <Label Grid.Row="2" Content="EquipmentId：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtEquipmentId" Grid.Row="2" Grid.Column="1"
                     Margin="0,4,0,4" Padding="4,3" VerticalAlignment="Center"/>
        </Grid>

        <!-- 測試查詢料號：只在「模擬模式」勾選時顯示，避免正式產線誤按對真實 MES 發查詢。
             Visibility 由 code-behind 的 LoadFrom(client, isSimulationMode) 設定。 -->
        <Border x:Name="BorderTestSection" Grid.Row="1" Margin="0,0,0,12" Padding="8"
                Background="#F5F5F5" BorderBrush="#CCC" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🧪 測試查詢料號（QuerySerialNoData）" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="條碼：" VerticalAlignment="Center" Width="40"/>
                    <TextBox x:Name="TxtTestProductId" Width="220" FontFamily="Consolas" FontSize="12"/>
                    <Button x:Name="BtnQuery" Content="查詢" Width="70" Margin="8,0,0,0" Click="BtnQuery_Click"/>
                </StackPanel>
                <TextBox x:Name="TxtQueryResult" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12" Height="120"
                         VerticalScrollBarVisibility="Auto" Background="White"/>
            </StackPanel>
        </Border>

        <!-- 按鈕列 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="✔ 儲存" Width="80" Margin="0,0,8,0" Padding="8,4"
                    Background="#0078D4" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="✘ 取消" Width="80" Padding="8,4"
                    Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
