<Window x:Class="Slot_Inspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Slot_Inspection"
        xmlns:vm="clr-namespace:Slot_Inspection.ViewModels"
        xmlns:helper="clr-namespace:Slot_Inspection.Helper"
        mc:Ignorable="d"
        Title="Slot Inspection"
        Width="1366"
        Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#D9D9D9"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <helper:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <helper:BoolToHiddenConverter x:Key="BoolToHiddenConverter"/>
        <helper:AlarmListToTooltipConverter x:Key="AlarmListToTooltipConverter"/>
        <Style x:Key="SlotNameCellStyle" TargetType="Border">
            <Setter Property="Background" Value="#00B050"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="0,1,1,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNg}" Value="True">
                    <Setter Property="Background" Value="#E60000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SlotNameTemplate">
            <Border Style="{StaticResource SlotNameCellStyle}" Height="20">
                <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SlotImageTemplate">
            <Border BorderBrush="#333" BorderThickness="0,0,1,1" Height="74" Background="Black">
                <Grid>
                    <Image Source="{Binding ImageSource}" Stretch="Uniform"/>
                    <TextBlock x:Name="ImgPlaceholder" Text="IMG" Foreground="#88FFFFFF" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                    <Setter TargetName="ImgPlaceholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SlotValueTemplate">
            <Border BorderBrush="#333" BorderThickness="0,0,1,1" Height="22" Background="White">
                <TextBlock Text="{Binding Value, StringFormat=F2}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- 每個 Slot 卡片：Slot編號 + 圖像 + 數値全包在一起 -->
        <DataTemplate x:Key="SlotCardTemplate">
            <Border BorderBrush="#333" BorderThickness="0,1,1,1" Height="116">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <!-- SLOT 名稱 -->
                    <Border Grid.Row="0" Style="{StaticResource SlotNameCellStyle}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding Name}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 圖像（可點擊放大） -->
                    <Border Grid.Row="1" BorderBrush="#333" BorderThickness="0,0,0,1" Background="Black"
                            Cursor="Hand" Tag="{Binding}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenImageViewerCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <Grid>
                            <!-- 圖片+缺陷外框一起包進與原圖同尺寸的Grid，再用Viewbox整體等比例縮小成縮圖，框線位置才會跟圖片內容對齊 -->
                            <Viewbox Stretch="Uniform">
                                <Grid Width="{Binding ImageSource.PixelWidth}" Height="{Binding ImageSource.PixelHeight}">
                                    <Image Source="{Binding ImageSource}" Stretch="Fill"/>
                                    <ItemsControl ItemsSource="{Binding DefectBoxes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- StrokeThickness=25 是原圖座標系下的粗細，縮圖會把整張圖縮小數十倍，線要先天加粗才看得到 -->
                                                <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                                           Stroke="Red" StrokeThickness="25" Fill="Transparent"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="ImgPlaceholder" Text="IMG" Foreground="#88FFFFFF" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <!-- 放大提示 icon -->
                            <TextBlock Text="🔍" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Foreground="#AAFFFFFF" Margin="0,0,2,2"
                                       Visibility="{Binding ImageSource, Converter={x:Null}}"/>
                        </Grid>
                    </Border>

                    <!-- Value 三等分：Value / MeanIntensity / DistanceToRoiCenter，滑鼠移上去顯示說明 -->
                    <Border Grid.Row="2" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding Value, StringFormat=F2}" FontSize="9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="Value：偵測面積 (mm²)，用於判斷 NG 上下限"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                                <TextBlock Text="{Binding MeanIntensity, StringFormat=F0}" FontSize="9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="MeanIntensity：偵測區域平均灰階強度 (0~255)"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>

                            <Border Grid.Column="2">
                                <TextBlock Text="{Binding DistanceToRoiCenter, StringFormat=F1}" FontSize="9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="DistanceToRoiCenter：物件中心到 ROI 中心的偏移距離 (px)"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                    <Setter TargetName="ImgPlaceholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StateButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="RowTitleCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="AreaHeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <!-- Viewbox 包住全部內容，最大化時等比例縮放 -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1366" Height="780">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- EMO 緊急停止 常駐警示橫幅：獨立佔一列（不用疊層），Visibility=Collapsed 時列高自動收成 0，
                 不會佔位也不會蓋住 Header 的帳號/登出等按鈕。只要 IsEmoTriggered=true 就一直顯示，
                 EMO 復歸（軟體偵測到 X0 恢復正常）後自動消失，不需要操作員按確認。 -->
            <Border Grid.Row="0" HorizontalAlignment="Stretch"
                    Background="#E60000" BorderBrush="#8B0000" BorderThickness="0,0,0,3"
                    Padding="0,14"
                    Visibility="{Binding IsEmoTriggered, Converter={StaticResource BoolToVisConverter}}">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                  From="1.0" To="0.55" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <TextBlock Text="⚠ 緊急停止（EMO）已觸發！機台動作已中斷，請確認安全並復歸 EMO 後，重新執行原點賦歸"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>

            <!-- Header -->
            <Border Grid.Row="1" Background="#EFEFEF" BorderBrush="#999" BorderThickness="1" Margin="12,12,12,8" Padding="18,10"
                    IsEnabled="{Binding IsUnlocked}">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="聯策科技" FontSize="34" FontStyle="Italic" FontFamily="Times New Roman" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Slot Inspection" Foreground="#2E75B6" FontSize="36" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 機台運行狀態指示燈：未連線(灰)/待命中(綠)/運行中(藍)/暫停中-光閘(黃)/異常(紅) -->
                    <!-- 不設定固定Width，框線會依RunStateText實際文字長度自動縮放 -->
                    <!-- 異常時滑鼠移到燈號上可看到目前有哪些具名原因造成紅燈，不用回頭翻log -->
                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#FFFFFF" BorderBrush="#999" BorderThickness="1"
                            CornerRadius="6" Padding="16,6"
                            ToolTip="{Binding ActiveAlarms, Converter={StaticResource AlarmListToTooltipConverter}}"
                            ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#999999"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RunStateKey}" Value="Ready">
                                                <Setter Property="Fill" Value="#00B050"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunStateKey}" Value="Running">
                                                <Setter Property="Fill" Value="#2E86C1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunStateKey}" Value="Paused">
                                                <Setter Property="Fill" Value="#FFC000"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RunStateKey}" Value="Alarm">
                                                <Setter Property="Fill" Value="#E60000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding RunStateText}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 帳號相關按鈕：緊靠在狀態燈左側，不影響狀態燈本身的位置 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding CurrentUserDisplay}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0"/>
                        <Button Content="🔑 修改密碼" Command="{Binding ChangePasswordCommand}"
                                FontSize="13" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="👤 帳號管理" Command="{Binding OpenUserManagementCommand}"
                                FontSize="13" Padding="10,5" Margin="0,0,6,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"/>
                        <Button Content="📋 操作紀錄" Command="{Binding OpenAuditLogCommand}"
                                FontSize="13" Padding="10,5" Margin="0,0,6,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"/>
                        <Button Content="🔐 角色權限設定" Command="{Binding OpenRolePermissionCommand}"
                                FontSize="13" Padding="10,5" Margin="0,0,6,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"/>
                        <Button Content="🏷 料號設定" Command="{Binding OpenMaterialRecipeMapCommand}"
                                FontSize="13" Padding="10,5" Margin="0,0,6,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"
                                ToolTip="編輯料號 → 側別 → Recipe 對應表（Config/MaterialRecipeMap.json）"/>
                        <Button Content="🚪 登出" Command="{Binding LogoutCommand}"
                                FontSize="13" Padding="10,5"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 模擬模式警示：獨立佔一列，避免跟 Header 帳號按鈕搶版面（曾經因為擠壓導致「角色權限設定」「登出」按鈕被蓋住/擠出畫面）。
                 開啟時顯著標示，避免操作者忘記目前顯示的是假資料而誤判為實際量測結果；Visibility=Collapsed 時列高自動收成 0，不佔位。 -->
            <Border Grid.Row="2" HorizontalAlignment="Stretch" Background="#E67E22" BorderBrush="#A04000" BorderThickness="0,0,0,2"
                    Padding="0,6"
                    Visibility="{Binding IsSimulationMode, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="🧪 模擬模式（非實際量測結果）" Foreground="White" FontWeight="Bold" FontSize="16"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Main content -->
            <Border Grid.Row="3" Background="#F8F8F8" BorderBrush="#444" BorderThickness="1" Margin="12,0,12,0"
                    IsEnabled="{Binding IsUnlocked}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barcode + state -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 目前套用中的 Recipe：唯讀顯示，實際切換仍走「Recipe 切換」視窗；
                             原本放在最下方 Footer，移到這裡讓操作員一開始就先看到，跟 Barcode 一起判讀 -->
                        <Border Grid.Column="0" BorderBrush="#333" BorderThickness="1" Padding="12,0" Background="#FFF3E0">
                            <TextBlock Text="{Binding CurrentRecipeDisplay, StringFormat='📦 目前 Recipe：{0}'}"
                                       FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="1" BorderBrush="#333" BorderThickness="1" Padding="12,0">
                            <TextBlock Text="Barcode" VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="#333" BorderThickness="1">
                            <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="34"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0">
                                <TextBox.InputBindings>
                                    <!-- Enter 鍵觸發條碼確認（手動輸入或讀碼器自動填入後確認） -->
                                    <KeyBinding Key="Return" Command="{Binding ConfirmBarcodeCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Border>

                        <!-- X12=R / X13=L 側別顯示 -->
                        <Border Grid.Column="3" BorderBrush="#333" BorderThickness="1" Background="#E3F2FD">
                            <TextBlock Text="{Binding CarrierSide}"
                                       FontSize="34" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#1565C0"/>
                        </Border>

                        <!-- 原本這裡還有日期/時間兩顆按鈕，釋放掉讓其餘按鈕分到更多空間 -->
                        <Grid Grid.Column="4" Margin="2,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="⚙ 初始化"
                                    Command="{Binding InitAxesCommand}"
                                    Style="{StaticResource StateButtonStyle}"
                                    Background="#DAE8FC" FontSize="11" Padding="10,4"
                                    FontWeight="Bold" ToolTip="Config + Servo 激磁 + PLC 連線"/>
                            <Button Grid.Column="1" Content="🏠 原點賦歸"
                                    Command="{Binding HomeCommand}"
                                    Style="{StaticResource StateButtonStyle}"
                                    Background="#D5E8D4" FontSize="11" Padding="10,4"
                                    FontWeight="Bold" ToolTip="所有軸回原點"/>
                            <Button Grid.Column="2" Content="▶ RUN"
                                    Command="{Binding RunCommand}"
                                    Style="{StaticResource StateButtonStyle}"
                                    Background="#C6EFCE" FontSize="11" Padding="16,4"
                                    FontWeight="Bold" ToolTip="執行主流程：逐 Slot 移動、取像、存圖"/>
                            <Button Grid.Column="3" Content="⏹ STOP"
                                    Command="{Binding StopCommand}"
                                    Style="{StaticResource StateButtonStyle}"
                                    Background="#FFCCCC" FontSize="11" Padding="16,4"
                                    FontWeight="Bold"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Area A 標題 -->
                        <Border Grid.Column="0" Background="#2E75B6" BorderBrush="#1A4E8A" BorderThickness="1" Margin="0,2,4,2">
                            <TextBlock Text="{Binding AreaATitle}" FontSize="15" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                        </Border>
                        <!-- Area A Stats -->
                        <Border Grid.Column="1" BorderBrush="#333" BorderThickness="1" Background="#F0F4FA" Margin="0,2,0,2">
                            <UniformGrid Columns="4" DataContext="{Binding AreaA_Stats}">
                                <Border BorderBrush="#BCC" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center" Margin="4,3">
                                        <TextBlock Text="Result" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Result}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#BCC" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center" Margin="4,3">
                                        <TextBlock Text="Avg" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Avg, StringFormat=F2}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#BCC" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center" Margin="4,3">
                                        <TextBlock Text="Min" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Min, StringFormat=F2}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border>
                                    <StackPanel VerticalAlignment="Center" Margin="4,3">
                                        <TextBlock Text="Max" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Max, StringFormat=F2}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <!-- Area A Row 1+2 -->
                    <Grid Grid.Row="2" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左側固定標籤欄（兩排各一組） -->
                        <Border Grid.Column="0" BorderBrush="#333" BorderThickness="1,1,1,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="116"/>
                                    <RowDefinition Height="116"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="74"/>
                                        <RowDefinition Height="22"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="SLOT" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Image" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Value" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="74"/>
                                        <RowDefinition Height="22"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="SLOT" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Image" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="White">
                                        <TextBlock Text="Value" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Slot 卡片列表，13個一排自動換行 -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding AreaA_Row1}" ItemTemplate="{StaticResource SlotCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="13"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <!-- Area B 標頭 -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Area B 標題 -->
                        <Border Grid.Column="0" Background="#548235" BorderBrush="#375623" BorderThickness="1" Margin="0,2,4,2">
                            <TextBlock Text="{Binding AreaBTitle}" FontSize="15" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Area B Stats -->
                        <Border Grid.Column="1" BorderBrush="#333" BorderThickness="1" Background="#F0F4FA" Margin="0,2,0,2">
                            <UniformGrid Columns="4" DataContext="{Binding AreaB_Stats}">
                                <Border BorderBrush="#BCC" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center" Margin="4,3">
                                        <TextBlock Text="Result" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Result}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#BCC" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center" Margin="4,3">
                                        <TextBlock Text="Avg" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Avg, StringFormat=F2}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#BCC" BorderThickness="0,0,1,0">
                                    <StackPanel VerticalAlignment="Center" Margin="4,3">
                                        <TextBlock Text="Min" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Min, StringFormat=F2}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border>
                                    <StackPanel VerticalAlignment="Center" Margin="4,3">
                                        <TextBlock Text="Max" FontSize="9" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Max, StringFormat=F2}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>
                    </Grid>

                    <!-- Area B Row 1+2 -->
                    <Grid Grid.Row="5" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左側固定標籤欄（兩排各一組） -->
                        <Border Grid.Column="0" BorderBrush="#333" BorderThickness="1,1,1,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="116"/>
                                    <RowDefinition Height="116"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="74"/>
                                        <RowDefinition Height="22"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="SLOT" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Image" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Value" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="74"/>
                                        <RowDefinition Height="22"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="SLOT" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Background="White" BorderBrush="#333" BorderThickness="0,0,0,1">
                                        <TextBlock Text="Image" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="White">
                                        <TextBlock Text="Value" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Slot 卡片列表，13個一排自動換行 -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding AreaB_Row1}" ItemTemplate="{StaticResource SlotCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="13"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom tabs：常用功能留在列上，進階/少用功能收進「⋯ 更多」下拉 -->
            <UniformGrid Grid.Row="4" Columns="10" Margin="12,4,12,4" IsEnabled="{Binding IsUnlocked}">

                <Button Content="⚙ Setting"
                        Command="{Binding LightSettingsCommand}"
                        FontSize="11" Padding="4,4"
                        Background="#FFF9C4" FontWeight="Bold"
                        ToolTip="設定檔"/>
                <Button Content="{Binding LightGateBypassButtonText}"
                        Command="{Binding ToggleLightGateBypassCommand}"
                        FontSize="11" Padding="4,4"
                        FontWeight="Bold"
                        ToolTip="按下：切換為上料模式（關閉光閘，觸發不中斷流程，供人工上料使用）；再按一次切換為下料模式（開啟光閘，恢復正常防護）；按下 RUN 也會自動切換為下料模式">
                    <Button.Style>
                        <Style TargetType="Button">
                            <!-- OFF（光閘正常防護中）＝綠；ON（光閘保護暫停，上料中）＝橘，提醒安全防護目前暫停 -->
                            <Setter Property="Background" Value="#A5D6A7"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLightGateBypassActive}" Value="True">
                                    <Setter Property="Background" Value="#FFB74D"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="📷 讀取條碼"
                        Command="{Binding ReadBarcodeCommand}"
                        Style="{StaticResource StateButtonStyle}"
                        Background="#B4C7E7" FontSize="11" Padding="4,4"
                        FontWeight="Bold"
                        ToolTip="Y→491 → 偵測 X12/X13 → 移動 X 軸至讀碼位置"/>
                <Button Content="📦 移至取料位"
                        Command="{Binding MoveToPickPositionCommand}"
                        Style="{StaticResource StateButtonStyle}"
                        Background="#FFF2CC" FontSize="11" Padding="4,4"
                        FontWeight="Bold"
                        ToolTip="Y 軸移動到取料位置的座標"/>
                <Button Content="📦 Recipe 切換"
                        Command="{Binding PositionSettingsCommand}"
                        Style="{StaticResource StateButtonStyle}"
                        Background="#E2EFDA" FontSize="11" Padding="4,4"
                        FontWeight="Bold"
                        ToolTip="切換／備份／刪除 Recipe 設定；也可在此微調 Y / X / ZL / ZR / Z安全高度座標"/>
                <Button Content="🔍 QC 比對"
                        Command="{Binding QcInspectionCommand}"
                        Style="{StaticResource StateButtonStyle}"
                        Background="#CFE2F3" FontSize="11" Padding="4,4"
                        FontWeight="Bold"
                        ToolTip="開啟 QC 比對儀表板：拿生效 Recipe 的 R/L 基準比對每輪量測結果，並可存基準、調容差"/>
                <Button Content="🔄 SLC Reset"
                        Command="{Binding SlcResetCommand}"
                        FontSize="11" Padding="4,4"
                        Background="#F8CECC" FontWeight="Bold"
                        ToolTip="送出 SLC Reset 訊號（Y0 pulse），完成後彈出提示"/>
                <Button Content="🔄 EMO Reset"
                        Command="{Binding EmoResetCommand}"
                        FontSize="11" Padding="4,4"
                        Background="#F8CECC" FontWeight="Bold"
                        ToolTip="確認 EMO 已釋放、現場安全後按下，才會清除 EMO 異常燈號/訊息（僅按下 EMO 又放開後可按）"/>
                <!-- 這一格：Admin 顯示「暫停板子感測」，非 Admin 改顯示「CSV Result」，不留空格 -->
                <Grid Margin="1">
                    <Button Content="{Binding BoardSensorBypassButtonText}"
                            Command="{Binding ToggleBoardSensorBypassCommand}"
                            FontSize="11" Padding="4,4"
                            Background="#F8CECC" FontWeight="Bold"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="Admin專用：暫時忽略 X3/X11 雷射感測（板子放置檢查），讓 RUN 不被卡住；再按一次恢復正常判斷"/>
                    <Button Content="📄 CSV Result"
                            Command="{Binding OpenResultFolderCommand}"
                            FontSize="11" Padding="4,4"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"
                            ToolTip="開啟 CSV 報表資料夾"/>
                </Grid>

                <!-- 📋 其他：點開後在上方彈出選單（見下方 MoreMenuToggle 綁定的遮罩＋面板） -->
                <ToggleButton x:Name="MoreMenuToggle" Content="📋 其他"
                              FontSize="11" FontWeight="Bold" Padding="4,4" Margin="1"
                              Background="#ECECEC" BorderBrush="#333" BorderThickness="1"
                              ToolTip="裁切設定、WebAPI 設定、CSV、安定延遲、模擬模式等少用/進階功能"/>
            </UniformGrid>

            <!-- Footer -->
            <Border Grid.Row="5" Background="#2E86C1" Margin="12,0,12,12">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左半：狀態訊息 -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 右半：MES 連線狀態（目前 Recipe 已移到上方 Barcode 列最前面顯示） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#999999"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MesStatusKey}" Value="Connected">
                                            <Setter Property="Fill" Value="#00B050"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MesStatusKey}" Value="Disconnected">
                                            <Setter Property="Fill" Value="#E60000"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding MesStatusText}" FontSize="13"
                                   VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 「📋 其他」下拉：點畫面任一處關閉（透明遮罩 ToggleButton 綁同一個 IsChecked）。
                 刻意不用 Popup——整個畫面包在 Viewbox 裡等比例縮放，Popup 是獨立視窗不會跟著縮放，會比例不一致。 -->
            <ToggleButton Grid.RowSpan="6" Focusable="False"
                          IsChecked="{Binding IsChecked, ElementName=MoreMenuToggle, Mode=TwoWay}"
                          Visibility="{Binding IsChecked, ElementName=MoreMenuToggle, Converter={StaticResource BoolToVisConverter}}"
                          Background="Transparent">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Border Grid.RowSpan="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,86" Padding="4"
                    Background="White" BorderBrush="#666" BorderThickness="1"
                    Visibility="{Binding IsChecked, ElementName=MoreMenuToggle, Converter={StaticResource BoolToVisConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel MinWidth="240">
                    <StackPanel Orientation="Horizontal" Margin="8,6">
                        <CheckBox Content="⏱ 安定延遲" FontSize="12" Margin="0,0,18,0"
                                  IsChecked="{Binding EnableAxisSettleDelay, Mode=TwoWay}"
                                  IsEnabled="{Binding CanToggleAxisSettleDelay}"
                                  ToolTip="勾選：ZL/ZR 到位後等待 150 ms 再拍照，防止機械振動造成影像模糊"/>
                        <CheckBox Content="🧪 模擬模式" FontSize="12"
                                  IsChecked="{Binding IsSimulationMode, Mode=TwoWay}"
                                  IsEnabled="{Binding CanToggleSimulationMode}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"
                                  ToolTip="勾選=全模擬(Debug-Sim)，取消=實機模式(可空跑)。RUN/DryRun執行中無法切換，需先停止。"/>
                    </StackPanel>
                    <Separator Margin="4,2"/>
                    <Button Content="✂ 裁切設定" Margin="4,3" Padding="6,4" FontSize="12"
                            HorizontalContentAlignment="Left"
                            Command="{Binding CropSettingsCommand}" Click="MoreMenuAction_Click"
                            ToolTip="設定 C1~C4 各相機的影像裁切 ROI（X/Y/W/H）"/>
                    <Button Content="🌐 WebAPI 設定" Margin="4,3" Padding="6,4" FontSize="12"
                            HorizontalContentAlignment="Left"
                            Command="{Binding WebApiTestCommand}" Click="MoreMenuAction_Click"
                            ToolTip="設定 MES WebAPI 連線位址（BaseUrl / EquipmentId / ProductId）"/>
                    <!-- 非 Admin 已在下方工具列直接看得到 CSV Result，這裡只留給 Admin（Admin 那格是暫停板子感測） -->
                    <Button Content="📄 CSV Result" Margin="4,3" Padding="6,4" FontSize="12"
                            HorizontalContentAlignment="Left"
                            Command="{Binding OpenResultFolderCommand}" Click="MoreMenuAction_Click"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="開啟 CSV 報表資料夾"/>
                </StackPanel>
            </Border>

            <!-- 鎖定遮罩：蓋住整個視窗，畫面內容仍在背景看得到。
                 閒置逾時、登出、開機尚未登入都一律要求重新完整登入（LoginWindow 會另外彈出），
                 這裡只負責擋互動＋顯示狀態說明，不提供密碼輸入框，避免跟LoginWindow疊出兩份輸入介面。
                 「重新登入」按鈕是因為使用者若直接把跳出的LoginWindow關掉/取消，該視窗就消失了，
                 鎖定畫面必須留一個入口能再叫出一次，否則會卡在「鎖定中卻沒有任何可操作介面」。 -->
            <Grid Grid.RowSpan="6" Background="#CC000000"
                  Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisConverter}}">
                <Border Background="#EFEFEF" BorderBrush="#999" BorderThickness="1" CornerRadius="8"
                        Width="320" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <TextBlock Text="🔒 畫面已鎖定" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="請於彈出的登入視窗重新輸入帳號密碼" FontSize="13"
                                   HorizontalAlignment="Center" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="重新登入" Height="32" Background="#2E86C1" Foreground="White"
                                FontWeight="Bold" Command="{Binding RetryLoginCommand}"
                                ToolTip="如果登入視窗被關掉或取消了，按這裡再叫出一次"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
